# Copy to .env for deployment settings. Application settings are saved in
# data/config.json; see README.md for the one-time legacy environment import.

# Data directory for the daemon and one-shot CLI.
# VBMUX_DATA_DIR=./data

# Host path mounted to /home/node/.codex so Codex auth persists in Docker.
# Defaults to ${HOME}/.codex when omitted.
# CODEX_HOST_DIR=/Users/you/.codex
